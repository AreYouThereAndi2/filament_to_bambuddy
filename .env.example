# Copy to .env and fill in. (.env is gitignored — keep your key out of version control.)
BAMBUDDY_URL=https://your-bambuddy.example.com
BAMBUDDY_API_KEY=your-bambuddy-api-key

# Optional:
# DEFAULT_LABEL_WEIGHT=1000
# Your Spoolman, as this container reaches it: its filaments fill the form
# (temperatures, empty spool, price) and get their empty fields filled in.
# SPOOLMAN_URL=http://spoolman:7912
# INVENTORY_MODE=spoolman

# How often the stock is checked for filament running out (hours), when the
# message is switched on in the page (Your stock -> Running low).
# REORDER_CHECK_HOURS=3
